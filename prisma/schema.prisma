// Домовёнок — схема данных домашнего хозяйства
// SQLite + Prisma. Справочник моделей: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Комната (зона) дома
model Room {
  id        String   @id @default(cuid())
  name      String   @unique
  emoji     String   @default("🏠")
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  tasks     Task[]
}

// Задача по дому: уборка, ремонт, покупка и т.д.
// status: "todo" | "doing" | "done"
// priority: "low" | "medium" | "high"
model Task {
  id          String    @id @default(cuid())
  title       String
  roomId      String?
  room        Room?     @relation(fields: [roomId], references: [id], onDelete: SetNull)
  priority    String    @default("medium")
  status      String    @default("todo")
  dueDate     DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status])
  @@index([roomId])
}

// Расход на домохозяйство (сумма в рублях)
// category: "groceries" | "supplies" | "repairs" | "utilities" | "tech" | "other"
model Expense {
  id        String   @id @default(cuid())
  title     String
  amount    Int
  category  String   @default("other")
  date      DateTime @default(now())
  createdAt DateTime @default(now())

  @@index([date])
}

// Настройки хозяйства (key-value): например, месячный бюджет
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
